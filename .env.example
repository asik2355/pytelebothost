# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FREESTYLE_API_KEY: Optional Freestyle.sh API key to connect directly to your external 8GB/32GB Ubuntu Cloud VM.
FREESTYLE_API_KEY=

# VITE_VPS_API_URL: Set your VPS Backend API URL when hosting Frontend on Vercel
# Example: http://194.163.148.91:3000 or https://api.yourdomain.com
VITE_VPS_API_URL=

# VITE_VPS_API_SECRET: Optional security token for authorizing Vercel Frontend requests to your VPS
VITE_VPS_API_SECRET=

# Firebase Client Configuration (Can be passed as a single JSON key OR individual keys)
# Option 1 (Single JSON):
FIREBASE_JSON_KEY={"apiKey":"AIzaSy...","authDomain":"bot-hostbd.firebaseapp.com","projectId":"bot-hostbd","storageBucket":"bot-hostbd.appspot.com","messagingSenderId":"1022124067652","appId":"1:1022124067652:web:1584c30cbe0a273b0a98f1"}

# Option 2 (Individual Keys):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=bot-hostbd.firebaseapp.com
FIREBASE_PROJECT_ID=bot-hostbd
FIREBASE_STORAGE_BUCKET=bot-hostbd.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1022124067652
FIREBASE_APP_ID=

